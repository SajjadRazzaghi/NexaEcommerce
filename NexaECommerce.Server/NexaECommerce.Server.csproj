<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- غیرفعال کردن Warning As Error برای NU1605 -->
		<NoWarn>NU1605</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- EF Core -->
		<PackageReference Include="MailKit" Version="4.17.0" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
		
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<!-- Swagger -->
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
		<PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />

		<!-- Scalar (جایگزین مدرن Swagger UI) -->
		<PackageReference Include="Scalar.AspNetCore" Version="1.2.3" />

	
		<!-- AutoMapper -->
		<PackageReference Include="AutoMapper" Version="12.0.1" />
		<PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />

		<!-- Logging -->
		<PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />

		<!-- Asp.Versioning -->
		<PackageReference Include="Asp.Versioning.Mvc" Version="8.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NexaEcommerce.Modules\NexaEcommerce.Modules.Orders\NexaEcommerce.Modules.Orders.csproj" />
		<ProjectReference Include="..\NexaEcommerce.SharedKernel\NexaEcommerce.SharedKernel.csproj" />
		<ProjectReference Include="..\NexaEcommerce.Modules\NexaEcommerce.Modules.Catalog\NexaEcommerce.Modules.Catalog.csproj" />
		<ProjectReference Include="..\NexaEcommerce.Modules\NexaEcommerce.Modules.ShoppingCart\NexaEcommerce.Modules.ShoppingCart.csproj" />
		<ProjectReference Include="..\NexaEcommerce.Modules\NexaEcommerce.Modules.Orders\NexaEcommerce.Modules.Orders.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="wwwroot\uploads\" />
	</ItemGroup>

</Project>
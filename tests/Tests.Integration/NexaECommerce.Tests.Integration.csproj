<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are executables (they host their own runner). -->
    <OutputType>Exe</OutputType>
    <!-- xUnit1051 asks every CancellationToken-accepting call (every HttpClient call) to thread
         TestContext.Current.CancellationToken. In these short, illustrative tests that ceremony hurts
         readability more than it helps, so we opt the rule out suite-wide. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
	  <NoWarn>NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="MediatR.Extensions.Microsoft.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.9.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <!-- WebApplicationFactory<Program> spins the real pipeline in-memory. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
    <!-- A SqliteConnection the factory keeps for the test database (temp file per run). -->
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\NexaECommerce.Server\NexaECommerce.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQLite transitive vuln (GHSA-2m69-gcr7-jv3q) is justified + suppressed in NexaECommerce.Server.csproj;
         repeated here because NuGetAuditSuppress doesn't flow across a ProjectReference. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

</Project>
